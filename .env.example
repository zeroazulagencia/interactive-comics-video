OPENAI_APIKEY=your-openai-key-here
REPLICATE_APIKEY=your-replicate-token-here
DATABASE_URL="file:./dev.db"

# Opcional — por defecto gpt-5.5 y gpt-image-1
# OPENAI_TEXT_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-1

# Contraseña de acceso a toda la app (HTTP Basic Auth). Si se deja vacío, no pide login.
APP_USERNAME=admin
APP_PASSWORD=change-me
